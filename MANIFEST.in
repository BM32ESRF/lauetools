# sdist content: setuptools-scm adds all files tracked by git; heavy files are removed below.
# Example images, notebooks HTML and generated documentation are published as GitHub release
# assets (see LaueTools/notebooks/download_examples.py) to keep each PyPI release small.
include *.md
graft LaueTools
prune doc/build
prune doc/_build
prune LaueTools/LaueImages
global-exclude *.html *.mccd *.tif *.tiff *.h5 *.hdf5 *.angles *.pickle *.npy
global-exclude *.local.ipynb *.local.yaml
# jupyter checkpoints (copies with outputs), personal and temporary files of the notebooks folders
global-exclude *-checkpoint.* *_jsm.ipynb Untitled*.ipynb slurm-*.out
prune LaueTools/notebooks/notebooks
exclude LaueTools/notebooks/testZrO2_*
global-exclude *.pyc
prune */__pycache__
exclude LaueTools/Diamond/*.ipynb
# small example images needed by tests and tutorials
include LaueTools/LaueImages/small_example_*
